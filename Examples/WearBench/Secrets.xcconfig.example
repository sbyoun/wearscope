// Copy to Secrets.xcconfig (gitignored) and fill in your values.
// Get MWDAT credentials at the Meta Wearables Developer Center.
TEAM_ID = YOUR_APPLE_TEAM_ID
MWDAT_APPLICATION_ID = your-mwdat-app-id
MWDAT_CLIENT_TOKEN = your-mwdat-client-token

// Optional: WearScope cloud upload (leave empty for local-only mode)
WS_API_KEY =
WS_ENDPOINT = https:/$()/your-wearscope-server
